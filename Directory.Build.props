<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Gustavo Brown</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Gustavo Brown</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      INVARIANT: our code compiles with ZERO warnings. Enforced mechanically —
      any warning (from src/ or tests/) fails the build, so it cannot be
      ignored and accumulate. Fix the warning at its source; do not suppress it
      wholesale. A genuinely unavoidable, understood case is silenced narrowly
      and locally (a targeted `#pragma warning disable <code>` with a comment,
      or `NoWarn` for one project), never by relaxing this. The vs/ debugger
      projects have their own Directory.Build.props and are not covered here.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      ONE output tree per configuration, whatever the Platform. Historically
      `dotnet build` (AnyCPU) wrote bin\<cfg> while Visual Studio and the
      -p:Platform=x64 command line wrote bin\x64\<cfg> — two trees, each
      refreshed only by its own invocation, so whichever one a script or a
      launch config pointed at was stale half the time (the "x64 trap" that
      bit the debugger arc repeatedly). Now both invocations land in
      bin\<cfg>\net10.0: the last build wins, and there is nothing stale to
      point at. Intermediates (obj\) keep the platform split so incremental
      builds of different platforms do not clobber each other.
    -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
  </PropertyGroup>

  <!--
    Opt-in diagnostic instrumentation. Each property defines a compile
    constant that gates a family of [System.Diagnostics.Conditional]-
    attributed dump methods scattered through the engine. Production
    builds (no property set) strip every call site at compile time —
    zero runtime cost. These build-time constants are distinct from the
    runtime SHUMWAY_* environment variables; both are catalogued in
    docs/guide/configuration.md.

    Activate from the command line, e.g.:
      dotnet build -p:ShumwayRetractTrace=true
      dotnet build -p:ShumwayCpTrace=true

    Or via env var (cmd/PowerShell):
      set ShumwayRetractTrace=true & dotnet build
  -->
  <PropertyGroup Condition="'$(ShumwayRetractTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);SHUMWAY_RETRACT_TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ShumwayCpTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);SHUMWAY_CP_TRACE</DefineConstants>
  </PropertyGroup>

  <!--
    Phase 20 performance profiling. Enables the [Conditional]-attributed
    hooks in Profiler (opcode histogram, per-predicate / per-builtin
    counts + inclusive time, backtrack / unify / choice-point counters).
    Off by default — every call site is stripped at compile time, so a
    normal build pays nothing. Turn on with:
      dotnet build -p:ShumwayProfile=true
  -->
  <PropertyGroup Condition="'$(ShumwayProfile)' == 'true'">
    <DefineConstants>$(DefineConstants);SHUMWAY_PROFILE</DefineConstants>
  </PropertyGroup>

  <!--
    Chunk 414 — env-var-activated developer diagnostics (the SHUMWAY_*_DIAG /
    dump / survey / GC-fuzz family). The [Conditional("SHUMWAY_DIAG")] hooks
    only exist in builds made with:
      dotnet build -p:ShumwayDiag=true
    A normal build — Release OR Debug — strips every call site at compile
    time: the env-var checks themselves are gone from the IL, so a Prolog
    application running on a stock Shumway build pays nothing and leaks no
    diagnostic surface.
  -->
  <PropertyGroup Condition="'$(ShumwayDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);SHUMWAY_DIAG</DefineConstants>
  </PropertyGroup>

</Project>
