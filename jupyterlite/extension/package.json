{
  "name": "@shumway/jupyterlite-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "A JupyterLite kernel for Prolog on the WebShumway runtime",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js}",
    "style/**/*.{css,svg}"
  ],
  "scripts": {
    "build": "tsc --sourceMap && jupyter labextension build --development True .",
    "build:prod": "tsc && jupyter labextension build .",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@dagrejs/dagre": "3.1.3",
    "@jupyterlab/application": "^4.6.6",
    "@jupyterlab/codemirror": "^4.6.6",
    "@jupyterlab/coreutils": "^6.5.0",
    "@jupyterlab/services": "^7.5.0",
    "@jupyterlite/services": "0.8.7"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.0",
    "typescript": "~5.9.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    }
  }
}
