<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Core\Shumway.Core.csproj" />
    <ProjectReference Include="..\Shumway.Compiler\Shumway.Compiler.csproj" />
    <ProjectReference Include="..\Shumway.Interpreter\Shumway.Interpreter.csproj" />
    <ProjectReference Include="..\Shumway.Compiler.Il\Shumway.Compiler.Il.csproj" />
    <ProjectReference Include="..\Shumway.Builtins\Shumway.Builtins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shumway.Tests.Embedding" />
    <!-- The top level reads Solution.ValueRootAddresses to display cyclic terms
         as their query variable (A = [a, b | A]). Granted to the shared library
         rather than to a front-end: the REPL and the web UI both format answers
         through it. -->
    <InternalsVisibleTo Include="Shumway.TopLevel" />
    <!-- The REPL itself still reaches for engine internals of its own
         (PrintLoadProfile, PromoteBareBundleModulesToUser). -->
    <InternalsVisibleTo Include="shumway" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShumwayTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Framework-inbox from .NET Core on; packages here. System.Text.Json is
         the DAP wire format; Bcl.AsyncInterfaces is IAsyncEnumerable for
         QueryAsync. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <!-- The emitters compile for net48 too: the net48 toolchain emits
         FRAMEWORK apps (the stub project targets the RUNNING toolchain's TFM;
         net48 output is a folder — exe + DLLs + config — since Framework has
         no single-file publish). The BUILD machine still needs the .NET SDK
         (`dotnet build` compiles the stub); target machines only need
         .NET Framework 4.8. -->
  </ItemGroup>

</Project>
