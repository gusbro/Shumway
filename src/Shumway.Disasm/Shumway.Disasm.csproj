<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Core\Shumway.Core.csproj" />
    <ProjectReference Include="..\Shumway.Compiler\Shumway.Compiler.csproj" />
    <ProjectReference Include="..\Shumway.Compiler.Il\Shumway.Compiler.Il.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>shumway-disasm</AssemblyName>
    <RootNamespace>Shumway.Disasm</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET's dynamic PGO runs newly compiled code instrumented before it
         optimizes it. A tool's run is short enough to spend much of itself
         in that code, and a long one gains nothing measurable from it. -->
    <TieredPGO>false</TieredPGO>
    <RollForward>Major</RollForward>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
