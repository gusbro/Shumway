<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Core\Shumway.Core.csproj" />
    <ProjectReference Include="..\Shumway.Compiler\Shumway.Compiler.csproj" />
    <ProjectReference Include="..\Shumway.Embedding\Shumway.Embedding.csproj" />
    <!-- The baker behind the wasm option. net10 only, like the backend itself: the net48
         toolchain reports the option as unavailable. -->
    <ProjectReference Include="..\Shumway.Compiler.Wasm\Shumway.Compiler.Wasm.csproj"
                      Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>shumway-link</AssemblyName>
    <RootNamespace>Shumway.Link</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-targeted for the .NET Framework spike (branch netfx-target): a
         net48 build of the toolchain links WITH the Framework persisted-IL
         emitter, so its "with compiled il" bundles carry mscorlib-referencing
         IL that a net48 HOST can bind (the net10 toolchain's IL references
         System.Private.CoreLib, which Framework cannot resolve; such bundles
         silently fall back to bytecode there). See
         src/Shumway.Core/Shumway.Core.csproj for the pattern. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShumwayTargetFrameworks)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
