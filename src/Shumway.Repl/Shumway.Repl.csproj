<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>shumway</AssemblyName>
    <RootNamespace>Shumway.Repl</RootNamespace>

    <!-- Native AOT. The REPL is the AOT-publish target: `dotnet publish
         -p:PublishAot=true` produces a self-contained native `shumway`
         executable. The engine runs Tier-0 (the bytecode interpreter)
         only — Tier-1 IL promotion is runtime code generation and is
         cleanly skipped under AOT (see IlPromotionStore /
         PrologEngine).

         Gated on the publish phase: when PublishAot is set unconditionally
         the build phase also flips `RuntimeFeature.IsDynamicCodeSupported`
         to false, which silently disables Tier-1 even on a JIT-hosted
         `dotnet build` + `dotnet shumway.dll` run. We want the JIT-
         hosted REPL to enjoy Tier-1 when SHUMWAY_IL_PROMOTE is set.
         Pass `-p:PublishAot=true` to `dotnet publish` for an AOT-native
         build; omit it everywhere else. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Embedding\Shumway.Embedding.csproj" />
    <ProjectReference Include="..\Shumway.TopLevel\Shumway.TopLevel.csproj" />
  </ItemGroup>

  <!-- ADR-038 — ship the repo lib/ next to the executable so the engine's
       default library search path (AppContext.BaseDirectory/lib) resolves
       library(X) for both `dotnet run` and a published build. -->
  <ItemGroup>
    <Content Include="..\..\lib\**\*.pl"
             Link="lib\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
