<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Core\Shumway.Core.csproj" />
    <ProjectReference Include="..\Shumway.Embedding\Shumway.Embedding.csproj" />
    <ProjectReference Include="..\Shumway.Compiler.Wasm\Shumway.Compiler.Wasm.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>shumway-wasmbake</AssemblyName>
    <RootNamespace>Shumway.WasmBake</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A build tool for the web target only: net10, never netfx. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
