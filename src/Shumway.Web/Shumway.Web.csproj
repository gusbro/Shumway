<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <AssemblyName>webshumway</AssemblyName>
    <RootNamespace>Shumway.Web</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- The engine's culture handling is invariant everywhere else (see the
         REPL); keep the browser build identical and skip the ICU payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Sigil (Tier-1's IL emitter) is a third-party assembly we cannot annotate,
         so the trimmer reports IL2104 for it. Narrow and local, per the repo's
         zero-warning rule: it is scoped to THIS project, names the one code, and
         is understood — the browser never emits IL (RuntimeCaps folds Tier-1 off),
         so Sigil's code is unreachable here. Every warning from OUR code was fixed
         at the source instead; nothing else is silenced. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <!-- The service worker must NOT be fingerprinted. Its URL determines its
         scope and its identity: a name that changes every publish would register
         a new worker each time and leave the old ones in place. It is versioned
         from the inside instead, by its cache name. -->
    <StaticWebAssetFingerprintPattern Include="ServiceWorker" Pattern="sw.js" Expression="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shumway.Embedding\Shumway.Embedding.csproj" />
    <ProjectReference Include="..\Shumway.TopLevel\Shumway.TopLevel.csproj" />
  </ItemGroup>

  <!-- The browser cannot emit IL (see RuntimeCaps), so declare it as a link-time
       constant: the trimmer folds RuntimeCaps.SupportsRuntimeCodegen to false,
       deletes every Tier-1 branch behind it, and the IL compiler and its Sigil
       dependency fall out of the payload as unreferenced. Nothing is suppressed
       and no source is conditionally compiled — the desktop build is untouched. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Shumway.RuntimeCodegen"
                                    Value="false" Trim="true" />
  </ItemGroup>

  <!-- Bake the standard library into a bundle the app embeds, so the engine boots
       without compiling the prelude: ~500 ms to ~345 ms cold under browser-wasm.
       Compression is switched off because browser-wasm has no Brotli codec (see
       BundleFormat). Inputs/Outputs make the target incremental: it re-bakes when
       the prelude changes, which is what keeps the embedded stdlib from going
       stale.

       Paths are spelled out rather than using IntermediateOutputPath: that
       property is set by the SDK targets, which are imported AFTER this file's
       body, so it is empty while the project is being evaluated — and an
       EmbeddedResource item is evaluated then. -->
  <PropertyGroup>
    <StdlibDir>obj\$(Configuration)\$(TargetFramework)\</StdlibDir>
    <StdlibBundle>$(StdlibDir)stdlib.shum</StdlibBundle>
    <ShumwayCompileDll>..\Shumway.Compile\bin\$(Configuration)\net10.0\shumway-compile.dll</ShumwayCompileDll>
    <ShumwayLinkDll>..\Shumway.Link\bin\$(Configuration)\net10.0\shumway-link.dll</ShumwayLinkDll>
  </PropertyGroup>

  <Target Name="BakeStdlibBundle"
          BeforeTargets="PrepareForBuild"
          Inputs="boot.pl;..\Shumway.Embedding\Prelude.cs"
          Outputs="$(StdlibBundle)">
    <!-- Ordering without a ProjectReference: a browser-wasm app is self-contained
         and may not reference a framework-dependent executable (NETSDK1150), so
         the two CLIs are built explicitly here instead. -->
    <MSBuild Projects="..\Shumway.Compile\Shumway.Compile.csproj;..\Shumway.Link\Shumway.Link.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
    <MakeDir Directories="$(StdlibDir)" />
    <Exec Command="dotnet &quot;$(ShumwayCompileDll)&quot; boot.pl -o &quot;$(StdlibDir)boot.shmo&quot;" />
    <Exec Command="dotnet &quot;$(ShumwayLinkDll)&quot; &quot;$(StdlibDir)boot.shmo&quot; --stdlib --no-compress --entry web_boot/0 -o &quot;$(StdlibBundle)&quot;" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(StdlibBundle)" LogicalName="stdlib.shum" Visible="false" />
  </ItemGroup>

</Project>
