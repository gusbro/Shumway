<?xml version="1.0" encoding="utf-8"?>
<!--
  Shumway debugger - server-level Concord component (ADR-035).
  ComponentLevel 40501 < 100,000 => loads on the debug-monitor side (same box
  for local debugging, msvsmon when remote). Owns the custom runtime/module
  objects, runtime breakpoints and stepping.
-->
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">

  <ManagedComponent
    ComponentId="cf493d87-b43e-43db-9740-c5888f7002ec"
    ComponentLevel="40501"
    AssemblyName="Shumway.Debugger.Concord">

    <Class Name="Shumway.Debugger.Concord.ShumwayRemoteComponent">
      <Implements>

        <InterfaceGroup>
          <Filter>
            <SourceId RequiredValue="d451a420-0546-456d-911d-411363b9e55a"/>
          </Filter>
          <Interface Name="IDkmCustomMessageForwardReceiver"/>
        </InterfaceGroup>

        <InterfaceGroup>
          <Filter>
            <SourceId RequiredValue="a21369e2-7531-4158-953d-5f95790402cf"/>
          </Filter>
          <Interface Name="IDkmRuntimeBreakpointReceived"/>
        </InterfaceGroup>

        <!-- Every process pause: the one context where creating the custom runtime and
             the .pl modules reliably works (D0 proved a stack-walk-triggered create
             throws on the walk's transient container). -->
        <InterfaceGroup>
          <NoFilter/>
          <Interface Name="IDkmProcessExecutionNotification"/>
        </InterfaceGroup>

        <!-- D4: the engine's module loading is where a LAUNCHED session starts. Nothing has
             stopped (and nothing will, until a breakpoint is armed, which is what this does),
             so it is the only moment before the program runs. -->
        <InterfaceGroup>
          <Filter>
            <RuntimeId RequiredValue="DkmRuntimeId.Clr"/>
          </Filter>
          <Interface Name="IDkmModuleInstanceLoadNotification"/>
        </InterfaceGroup>

        <!-- D3: F9 in a .pl and F10/F11 in a Prolog frame are routed to us by the
             RuntimeId of the custom runtime the frames belong to. -->
        <InterfaceGroup>
          <Filter>
            <RuntimeId RequiredValue="3cd5801d-96c7-47d4-b4c4-a796b8fe7de9"/>
          </Filter>
          <Interface Name="IDkmRuntimeMonitorBreakpointHandler"/>
          <Interface Name="IDkmRuntimeStepper"/>
        </InterfaceGroup>

        <!-- D5: conditional breakpoints. The condition the user types on a .pl breakpoint
             is a Prolog goal; VS wraps it in a DkmEvaluationBreakpointCondition whose
             language is the breakpoint's (ours, via the module's DkmCompilerId) and routes
             it here by LanguageId — VERIFIED live: the 0.13 smoke log shows ParseCondition
             firing for a Blint.pl breakpoint. (A RuntimeId filter was tried here and broke
             the whole component's registration — no module loads, no breakpoints — so:
             LanguageId, which works.) ParseCondition is the moment we LEARN the text
             (recorded + forwarded to the engine through the channel; the ENGINE evaluates
             it at the Break, before notifying anyone); EvaluateCondition answers from the
             pinned snapshot — never a func-eval. -->
        <InterfaceGroup>
          <Filter>
            <LanguageId RequiredValue="9d7f8a51-0699-4828-99ba-047821c60783"/>
          </Filter>
          <Interface Name="IDkmLanguageConditionEvaluator"/>
        </InterfaceGroup>

      </Implements>
    </Class>

    <!-- Stepping, taken from the CLR. In a MANAGED debuggee the step is never offered to
         the custom runtime the Prolog frames belong to: the physical thread is stopped in
         engine C#, the CLR owns that location, and VS does not arbitrate (our custom
         stepper's OwnsCurrentExecutionLocation was called zero times across every smoke
         run, while F11 quietly did a C# step instead). AboveNormal puts us ahead of the
         built-in stepper; when we are not stopped at a Prolog port we decline, and C#
         stepping is exactly as it was. -->
    <Class Name="Shumway.Debugger.Concord.ShumwayClrStepper">
      <Implements>
        <InterfaceGroup Priority="AboveNormal">
          <Filter>
            <RuntimeId RequiredValue="DkmRuntimeId.Clr"/>
          </Filter>
          <Interface Name="IDkmRuntimeStepper"/>
        </InterfaceGroup>
      </Implements>
    </Class>

    <!-- The pause. Break All must not freeze a Prolog machine where it stands: at an
         arbitrary instruction it is mid-unification, inside a builtin, between frames, and
         it has NO call stack to show. Taking the request ahead of the built-in handler lets
         us ask the engine to stop at its next port instead - microseconds away, and a point
         where the stack is true. When Prolog is not running we decline, and the CLR freezes
         the process exactly as it did before. -->
    <Class Name="Shumway.Debugger.Concord.ShumwayAsyncBreak">
      <Implements>
        <InterfaceGroup Priority="AboveNormal">
          <NoFilter/>
          <Interface Name="IDkmAsyncBreak"/>
        </InterfaceGroup>
      </Implements>
    </Class>

  </ManagedComponent>
</Configuration>
