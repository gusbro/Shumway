<?xml version="1.0" encoding="utf-8"?>
<!--
  Shumway debugger - IDE-level frame decoder + expression evaluator (ADR-035).

  Routed to us by the RUNTIME id of the frame — NOT by the language id.

  That distinction cost a day. Filtering on LanguageId looks obviously right (the module
  reports a Prolog DkmCompilerId; surely a Prolog frame gets the Prolog evaluator) and it
  is silently, completely wrong: Visual Studio never asks a frame's compiler id at all
  (our GetCompilerId counter stayed at zero through every run while GetSourcePosition
  climbed), so no evaluator was ever routed and the Locals window came up empty with no
  error anywhere. An evaluator is chosen by WHOSE RUNTIME the frame belongs to. PTVS does
  the same, and uses LanguageId for exactly one thing: intrinsic-function evaluation.
-->
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">

  <ManagedComponent
    ComponentId="0f2f9b9f-9f0a-4a30-9c5f-4b1d6f1a9a2c"
    ComponentLevel="1999002"
    AssemblyName="Shumway.Debugger.Concord">

    <Class Name="Shumway.Debugger.Concord.ShumwayExpressionEvaluator">
      <Implements>
        <InterfaceGroup>
          <Filter>
            <RuntimeId RequiredValue="3cd5801d-96c7-47d4-b4c4-a796b8fe7de9"/>
          </Filter>
          <Interface Name="IDkmLanguageFrameDecoder"/>
          <Interface Name="IDkmLanguageExpressionEvaluator"/>
        </InterfaceGroup>
      </Implements>
    </Class>

  </ManagedComponent>
</Configuration>
