<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shumway.Debugger.Concord</RootNamespace>
    <AssemblyName>Shumway.Debugger.Concord</AssemblyName>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The VSDConfigTool build step compiles every VsdConfigXmlFiles item into this
         single binary manifest, deployed next to the DLL and read by Concord's
         component loader (see the ConcordExtensibilitySamples wiki,
         "Component discovery and configuration"). -->
    <VsdConfigFile>bin\$(Configuration)\$(TargetFramework)\Shumway.Debugger.Concord.vsdconfig</VsdConfigFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Known-good pair from the MIT ConcordExtensibilitySamples (Iris/HelloWorld).
         VS 2026 supports the 17.x API surface; revisit the pin if a v18 package line
         appears. -->
    <PackageReference Include="Microsoft.VisualStudio.Debugger.Engine" Version="17.0.2012801" />
    <PackageReference Include="Microsoft.VSSDK.Debugger.VSDConfigTool" Version="17.0.2012801">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- To read the notify method's token out of the engine DLL on disk, before the process
         it belongs to has run a single instruction. See ShumwayMetadata. -->
    <PackageReference Include="System.Reflection.Metadata" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-035 D2: the channel's wire format, compiled from the ENGINE's source.
         The debugger cannot reference the engine (net10 vs netstandard2.0), and two
         copies of a format definition drift silently — a debugger and a debuggee that
         disagree about the layout of a buffer do not fail loudly, they show the user a
         plausible, wrong stack. So the file is shared, not duplicated. -->
    <Compile Include="..\..\src\Shumway.Embedding\Debugging\DebugWire.cs"
             Link="Shared\DebugWire.cs" />
  </ItemGroup>

  <ItemGroup>
    <VsdConfigXmlFiles Include="ShumwayLocalComponent.vsdconfigxml" />
    <VsdConfigXmlFiles Include="ShumwaySymbolsComponent.vsdconfigxml" />
    <VsdConfigXmlFiles Include="ShumwayRemoteComponent.vsdconfigxml" />
    <VsdConfigXmlFiles Include="ShumwayEvaluatorComponent.vsdconfigxml" />
  </ItemGroup>

</Project>
