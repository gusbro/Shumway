<?xml version="1.0" encoding="utf-8"?>
<!--
  Shumway debugger - IDE-level call stack filter (ADR-035).
  Compiled by vsdconfigtool.exe into Shumway.Debugger.Concord.vsdconfig at build.

  ComponentLevel 1999000 = IDE side (levels > 100,000 load in devenv; < 100,000
  load in the debug monitor). Same level PTVS uses for its local component.

  NOTE: exactly ONE <ManagedComponent> (with ONE <Class>) per .vsdconfigxml —
  the schema rejects a second one, and all files still compile into a single
  .vsdconfig. One file per component.
-->
<Configuration xmlns="http://schemas.microsoft.com/vstudio/vsdconfig/2008">

  <ManagedComponent
    ComponentId="775f8710-e0fa-4781-aafb-0161cbf514b9"
    ComponentLevel="1999000"
    AssemblyName="Shumway.Debugger.Concord">

    <Class Name="Shumway.Debugger.Concord.ShumwayCallStackFilter">
      <Implements>
        <InterfaceGroup>
          <NoFilter/>
          <Interface Name="IDkmCallStackFilter"/>
        </InterfaceGroup>
        <!-- D5+: IDkmSetNextStatementQuery must live in the engine (IDE) process. We accept
             for any target inside our custom runtime and let the engine's actual move
             decide (a rewind's validity is live machine state). -->
        <InterfaceGroup>
          <NoFilter/>
          <Interface Name="IDkmSetNextStatementQuery"/>
        </InterfaceGroup>
      </Implements>
    </Class>

  </ManagedComponent>
</Configuration>
