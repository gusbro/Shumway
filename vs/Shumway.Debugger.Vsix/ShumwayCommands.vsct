<?xml version="1.0" encoding="utf-8"?>
<!-- Shumway debugger - the "Debug Prolog File" command (ADR-035, phase D4).
     It lives in two places, because there are two ways a person looks for it: on the Debug
     menu, where every other way of starting a session is; and on the editor's context menu,
     where the file itself is. -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
              xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidShumwayPackage">
    <Groups>
      <Group guid="guidShumwayCommandSet" id="ShumwayDebugGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_DEBUG"/>
      </Group>
      <Group guid="guidShumwayCommandSet" id="ShumwayContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidShumwayCommandSet" id="DebugPrologFileCommand"
              priority="0x0100" type="Button">
        <Parent guid="guidShumwayCommandSet" id="ShumwayDebugGroup"/>
        <!-- DynamicVisibility + the package's BeforeQueryStatus: the command SHOWS only on a
             .pl file. A permanently greyed item on every C# file would be noise. -->
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>Debug Prolog File (Shumway)</ButtonText>
          <!-- A canonical name makes the command addressable: the user can bind a key to it
               (Tools > Options > Keyboard), and the smoke script can invoke it. -->
          <CommandName>DebugPrologFile</CommandName>
          <CanonicalName>Shumway.DebugPrologFile</CanonicalName>
          <LocCanonicalName>Shumway.DebugPrologFile</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- The same command, also on the editor's right-click menu. -->
    <CommandPlacement guid="guidShumwayCommandSet" id="DebugPrologFileCommand" priority="0x0100">
      <Parent guid="guidShumwayCommandSet" id="ShumwayContextGroup"/>
    </CommandPlacement>
  </CommandPlacements>

  <Symbols>
    <GuidSymbol name="guidShumwayPackage" value="{CADEB786-9FD5-44C9-9522-E82E357571C7}" />
    <GuidSymbol name="guidShumwayCommandSet" value="{C74E33BF-2316-41CF-A971-B3BC83745619}">
      <IDSymbol name="ShumwayDebugGroup" value="0x1020" />
      <IDSymbol name="ShumwayContextGroup" value="0x1021" />
      <IDSymbol name="DebugPrologFileCommand" value="0x0100" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
