<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool: compiles and links one of the engine's Prolog
       libraries into the bundle Shumway.Libraries embeds. In-process over
       Shumway.Embedding rather than through shumway-link, because the CLIs
       reference Shumway.Libraries themselves (their executable stubs carry it):
       the bake has to sit below them in the build graph. Multi-targeted like
       shumway-link: the net48 build bakes IL a .NET Framework host can bind. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>shumway-librarybake</AssemblyName>
    <RootNamespace>Shumway.LibraryBake</RootNamespace>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShumwayTargetFrameworks)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shumway.Embedding\Shumway.Embedding.csproj" />
    <!-- The wasm backend is net10 only. -->
    <ProjectReference Include="..\..\src\Shumway.Compiler.Wasm\Shumway.Compiler.Wasm.csproj"
                      Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>

</Project>
