<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- .NET Framework caps any single array at 2GB unless the host opts out.
         A 64-bit net48 host running heap-hungry queries hits it in the engine's
         control-stack growth (Cell[] doubling) long before real memory runs
         out; this is the documented knob legacy hosts need. Irrelevant on x86,
         where the address space is the binding limit first. -->
    <gcAllowVeryLargeObjects enabled="true" />
  </runtime>
</configuration>
