<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR-040 — OPT-IN cross-dialect integration tests. These load REAL
    third-party libraries from another Prolog system's checkout (Scryer, SWI),
    so they cannot ship those sources and are NOT part of the routine gate.
    They are parameterised by environment variables naming each engine's
    library directory:

        SHUMWAY_SCRYER_LIB   e.g. C:/Scryer/lib
        SHUMWAY_SWI_LIB      e.g. C:/swipl/library

    A test whose engine dir is not set (or missing) is a no-op that passes with
    a logged "skipped" line, so a clone without the libraries does not fail. Run
    it explicitly, with the dirs you have:

        SHUMWAY_SCRYER_LIB=C:/Scryer/lib SHUMWAY_SWI_LIB=C:/swipl/library \
          dotnet test tests/Shumway.Tests.DialectInterop/

    We run it (with the dirs set) before closing a phase; a third party runs it
    if they want and have the libraries.
  -->
  <PropertyGroup>
    <!-- Multi-targeted like the rest of the suite: whether a third party's
         libraries load is a question about .NET Framework too, and that is
         where the answer differs (no runtime codegen assumptions, 32-bit). -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(ShumwayTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- A run with no engine directory configured verifies NOTHING; without
         this it reported ten passes, which is the same picture as a run that
         did the work. Skippable turns it into `Skipped: 10`. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shumway.Embedding\Shumway.Embedding.csproj" />
  </ItemGroup>

</Project>
